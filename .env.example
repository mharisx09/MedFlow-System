# PostgreSQL connection string (used by Prisma).
# Local example: postgresql://postgres:postgres@localhost:5432/medflow
DATABASE_URL=

# Resend API key. When set, transactional email is sent via Resend.
# If unset, the app falls back to SMTP (nodemailer).
RESEND_API_KEY=

# SMTP fallback settings (only used when RESEND_API_KEY is not set).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# "From" address used for outgoing email.
SMTP_FROM=Med Flow System <noreply@medflowsystem.co>

# Owner inbox that receives new lead notifications (quote/contact form submissions).
NOTIFY_EMAIL=

# Admin dashboard login email.
ADMIN_EMAIL=

# bcrypt hash of the admin password. Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=

# Secret for encrypting the admin session cookie. Min 32 random characters.
SESSION_SECRET=

# Public base URL of the site (used for absolute links in emails, sitemap, etc).
NEXT_PUBLIC_SITE_URL=https://www.medflowsystem.co
